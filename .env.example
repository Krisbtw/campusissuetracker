# FixMyCampus Environment Configuration Template
# Copy this file to .env and replace with your actual configuration

# Database Connection (PostgreSQL or MySQL)
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fixmycampus
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Alternative Single URL Connection String
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fixmycampus

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Google Gemini AI Integration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL (Optional - defaults to auto-detected URL)
# BASE_URL=http://localhost/fixmycampus/
